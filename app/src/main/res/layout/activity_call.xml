<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран звонка:
      * удалённое и локальное видео (SurfaceViewRenderer),
      * статус и индикатор прогресса,
      * сигнальные панели (offer / вставка ответа / answer) с кнопками
        «Копировать», «Поделиться», «Контакту» (выбор контакта+мессенджер),
        «QR-код» (генерация) и «Сканировать QR»,
      * панель управления (микрофон, видео, камера, завершение).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Удалённое видео (на весь экран). -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Кнопка качества (левый верхний угол). -->
    <ImageButton
        android:id="@+id/btnQuality"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_btn_circle"
        android:contentDescription="@string/btn_quality"
        android:elevation="4dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_sort_by_size" />

    <!-- Кнопка отправки файла (левый нижний угол). -->
    <ImageButton
        android:id="@+id/btnFile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_btn_circle"
        android:contentDescription="@string/btn_file"
        android:elevation="4dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_upload" />

    <!-- Локальное видео: контейнер (видео + маска + кнопка камеры). Перетаскивается. -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="110dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:elevation="4dp">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/localRenderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.p2pcall.ui.RoundedMaskView
            android:id="@+id/previewMask"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Кнопка переключения камеры (overlay на превью). -->
        <ImageButton
            android:id="@+id/btnSwitch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="#66000000"
            android:contentDescription="@string/btn_switch"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_camera" />
    </FrameLayout>

    <!-- Статус + индикатор связи + прогресс (сверху). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/qualityDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="●"
                android:textColor="#FFB300"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/bg_panel"
                android:padding="10dp"
                android:text="@string/status_initializing"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Нижний контейнер: сигнальные панели + кнопки управления. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/signalingScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Панель offer (для инициатора). -->
                <LinearLayout
                    android:id="@+id/panelOffer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_panel"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/offer_label"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/offer_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/offerLinkText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#33000000"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:padding="10dp"
                        android:textColor="@color/brand_light"
                        android:textColorLink="@color/brand_light"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCopyOffer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_copy" />

                        <Button
                            android:id="@+id/btnShareOffer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/brand"
                            android:text="@string/btn_share"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnContactOffer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_send_contact" />

                        <Button
                            android:id="@+id/btnQrOffer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/btn_show_qr" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Панель вставки ответной ссылки (для инициатора). -->
                <LinearLayout
                    android:id="@+id/panelPasteAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/bg_panel"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/waiting_answer_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/answerInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_answer_input"
                        android:inputType="textUri|textMultiLine"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnApplyAnswer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="@color/ok"
                            android:text="@string/btn_apply_answer"
                            android:textColor="@color/text_primary" />

                        <Button
                            android:id="@+id/btnScanAnswerQr"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/btn_scan_qr" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Панель answer (для принимающего). -->
                <LinearLayout
                    android:id="@+id/panelAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_panel"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/answer_label"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/answer_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/answerLinkText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#33000000"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:padding="10dp"
                        android:textColor="@color/brand_light"
                        android:textColorLink="@color/brand_light"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCopyAnswer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_copy" />

                        <Button
                            android:id="@+id/btnShareAnswer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/brand"
                            android:text="@string/btn_share"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnContactAnswer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_send_contact" />

                        <Button
                            android:id="@+id/btnQrAnswer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/btn_show_qr" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Панель управления. -->
        <LinearLayout
            android:id="@+id/controlsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_panel"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_control"
                android:padding="14dp"
                android:contentDescription="@string/btn_mic"
                android:src="@android:drawable/ic_btn_speak_now" />

            <ImageButton
                android:id="@+id/btnVideo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_btn_control"
                android:padding="14dp"
                android:contentDescription="@string/btn_video"
                android:src="@android:drawable/ic_menu_camera" />

            <ImageButton
                android:id="@+id/btnHangup"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_btn_hangup"
                android:padding="14dp"
                android:contentDescription="@string/btn_hangup"
                android:src="@android:drawable/ic_menu_call" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
